{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/theme-schema.json",
  "name": "omacosy",
  "vars": {
    "bg": "@background@",
    "fg": "@foreground@",
    "accent": "@accent@",
    "selection": "@selection_background@",
    "surface": "@color0@",
    "red": "@color1@",
    "green": "@color2@",
    "yellow": "@color3@",
    "blue": "@color4@",
    "magenta": "@color5@",
    "cyan": "@color6@",
    "white": "@color7@",
    "muted": "@readable_muted@",
    "ansiMuted": "@color8@",
    "brightRed": "@color9@",
    "brightGreen": "@color10@",
    "brightYellow": "@color11@",
    "brightBlue": "@color12@",
    "brightMagenta": "@color13@",
    "brightCyan": "@color14@",
    "brightWhite": "@color15@"
  },
  "colors": {
    "accent": "accent",
    "border": "blue",
    "borderAccent": "accent",
    "borderMuted": "muted",
    "success": "green",
    "error": "red",
    "warning": "yellow",
    "muted": "muted",
    "dim": "muted",
    "text": "fg",
    "assistantMessageText": "fg",
    "thinkingText": "muted",
    "selectedBg": "selection",
    "userMessageBg": "surface",
    "userMessageText": "fg",
    "customMessageBg": "surface",
    "customMessageText": "fg",
    "customMessageLabel": "accent",
    "toolPendingBg": "surface",
    "toolSuccessBg": "surface",
    "toolErrorBg": "surface",
    "toolTitle": "accent",
    "toolOutput": "fg",
    "mdHeading": "accent",
    "mdLink": "cyan",
    "mdLinkUrl": "muted",
    "mdCode": "brightBlue",
    "mdCodeBlock": "fg",
    "mdCodeBlockBorder": "muted",
    "mdQuote": "muted",
    "mdQuoteBorder": "muted",
    "mdHr": "muted",
    "mdListBullet": "cyan",
    "toolDiffAdded": "green",
    "toolDiffRemoved": "red",
    "toolDiffContext": "muted",
    "link": "cyan",
    "syntaxComment": "muted",
    "syntaxKeyword": "magenta",
    "syntaxFunction": "blue",
    "syntaxVariable": "fg",
    "syntaxString": "green",
    "syntaxNumber": "yellow",
    "syntaxType": "cyan",
    "syntaxOperator": "fg",
    "syntaxPunctuation": "fg",
    "thinkingOff": "muted",
    "thinkingMinimal": "muted",
    "thinkingLow": "blue",
    "thinkingMedium": "cyan",
    "thinkingHigh": "magenta",
    "thinkingXhigh": "accent",
    "thinkingMax": "accent",
    "bashMode": "cyan",
    "pythonMode": "yellow",
    "statusLineBg": "bg",
    "statusLineSep": "muted",
    "statusLineModel": "accent",
    "statusLinePath": "cyan",
    "statusLineGitClean": "green",
    "statusLineGitDirty": "yellow",
    "statusLineContext": "blue",
    "statusLineSpend": "cyan",
    "statusLineStaged": "green",
    "statusLineDirty": "yellow",
    "statusLineUntracked": "blue",
    "statusLineOutput": "magenta",
    "statusLineCost": "magenta",
    "statusLineSubagents": "accent"
  },
  "export": {
    "pageBg": "bg",
    "cardBg": "surface",
    "infoBg": "selection"
  },
  "terminal": {
    "background": "bg",
    "foreground": "fg",
    "chrome": "bg",
    "widget": "surface",
    "ansi": [
      "surface", "red", "green", "yellow", "blue", "magenta", "cyan", "white",
      "ansiMuted", "brightRed", "brightGreen", "brightYellow", "brightBlue", "brightMagenta", "brightCyan", "brightWhite"
    ]
  }
}
