# yazi flavor template, rendered by bin/yazi-theme-fragment on every theme-set.
# Tokens of the form at-sign NAME at-sign are palette entries from the theme's colors.toml:
#   accent, fg (foreground), bg (background), surface (color0), muted (color8),
#   red (color1), green (color2), yellow (color3), blue (color4),
#   magenta (color5), cyan (color6).
# Sections and keys follow yazi's preset theme-dark.toml; the accent drives the
# hovered row, the active tab and the mode badge, like rmpc. File icons keep
# yazi's preset colours.

[mgr]
cwd = { fg = "@cyan@" }

find_keyword  = { fg = "@yellow@", bold = true, italic = true, underline = true }
find_position = { fg = "@magenta@", bg = "reset", bold = true, italic = true }

symlink_target = { italic = true }

marker_copied   = { fg = "@green@", bg = "@green@" }
marker_cut      = { fg = "@red@", bg = "@red@" }
marker_marked   = { fg = "@cyan@", bg = "@cyan@" }
marker_selected = { fg = "@yellow@", bg = "@yellow@" }
marker_symbol   = "│"

count_copied   = { fg = "@bg@", bg = "@green@" }
count_cut      = { fg = "@bg@", bg = "@red@" }
count_selected = { fg = "@bg@", bg = "@yellow@" }

border_symbol = "│"
border_style  = { fg = "@muted@" }

[tabs]
active   = { fg = "@bg@", bg = "@accent@", bold = true }
inactive = { fg = "@accent@", bg = "@surface@" }

sep_inner = { open = "", close = "" }
sep_outer = { open = "", close = "" }

[mode]
normal_main = { fg = "@bg@", bg = "@accent@", bold = true }
normal_alt  = { fg = "@accent@", bg = "@surface@" }

select_main = { fg = "@bg@", bg = "@red@", bold = true }
select_alt  = { fg = "@red@", bg = "@surface@" }

unset_main = { fg = "@bg@", bg = "@red@", bold = true }
unset_alt  = { fg = "@red@", bg = "@surface@" }

[indicator]
parent  = { fg = "@fg@", bg = "@surface@" }
current = { fg = "@bg@", bg = "@accent@" }
preview = { underline = true }
padding = { open = "", close = "" }

[status]
overall   = {}
sep_left  = { open = "", close = "" }
sep_right = { open = "", close = "" }

perm_sep   = { fg = "@muted@" }
perm_type  = { fg = "@green@" }
perm_read  = { fg = "@yellow@" }
perm_write = { fg = "@red@" }
perm_exec  = { fg = "@cyan@" }

progress_label  = { bold = true }
progress_normal = { fg = "@accent@", bg = "@surface@" }
progress_error  = { fg = "@yellow@", bg = "@red@" }

[which]
cols            = 3
mask            = { bg = "@surface@" }
cand            = { fg = "@cyan@" }
rest            = { fg = "@muted@" }
desc            = { fg = "@magenta@" }
separator       = "  "
separator_style = { fg = "@muted@" }

[confirm]
border     = { fg = "@accent@" }
title      = { fg = "@accent@" }
body       = {}
list       = {}
btn_yes    = { reversed = true }
btn_no     = {}
btn_labels = [ "  [Y]es  ", "  (N)o  " ]

[spot]
border = { fg = "@accent@" }
title  = { fg = "@accent@" }

tbl_col  = { fg = "@accent@" }
tbl_cell = { fg = "@yellow@", reversed = true }

[notify]
title_info  = { fg = "@green@" }
title_warn  = { fg = "@yellow@" }
title_error = { fg = "@red@" }

icon_info  = ""
icon_warn  = ""
icon_error = ""

[pick]
border   = { fg = "@accent@" }
active   = { fg = "@magenta@", bold = true }
inactive = {}

[input]
border   = { fg = "@accent@" }
title    = {}
value    = {}
selected = { reversed = true }

[cmp]
border   = { fg = "@accent@" }
active   = { reversed = true }
inactive = {}

icon_file    = ""
icon_folder  = ""
icon_command = ""

[tasks]
border  = { fg = "@accent@" }
title   = {}
hovered = { fg = "@magenta@", bold = true }

[help]
on      = { fg = "@cyan@" }
run     = { fg = "@magenta@" }
desc    = {}
hovered = { reversed = true, bold = true }
footer  = { fg = "@bg@", bg = "@fg@" }

[filetype]
rules = [
	# Image
	{ mime = "image/*", fg = "@yellow@" },
	# Media
	{ mime = "{audio,video}/*", fg = "@magenta@" },
	# Archive
	{ mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "@red@" },
	# Document
	{ mime = "application/{pdf,doc,rtf}", fg = "@cyan@" },
	# Virtual file system
	{ mime = "vfs/{absent,stale}", fg = "@muted@" },
	# Special file
	{ url = "*", is = "orphan", bg = "@red@" },
	{ url = "*", is = "exec"  , fg = "@green@" },
	# Dummy file
	{ url = "*", is = "dummy", bg = "@red@" },
	{ url = "*/", is = "dummy", bg = "@red@" },
	# Fallback
	{ url = "*/", fg = "@blue@" },
]
