{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Phainon (白厄) full splash art - clear centered
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/images/phainon_clear.png",
    "width": 30,
    "height": 17,
    "position": "left",
    "padding": {
      "left": 2,
      "right": 2,
      "top": 3
    }
  },

  "display": {
    "separator": " ",
    "color": {
      "keys": "default",
      "title": "default"
    }
  },

  "modules": [
    // ── Top Color Bar ──
    {
      "type": "custom",
      "format": "  █▓▒ █▓▒ █▓▒ █▓▒ █▓▒ █▓▒ █▓▒",
      "outputColor": "90"
    },

    "break",

    // ── Top Border ──
    {
      "type": "custom",
      "format": "  ┌────────────────────────────────────────────────────────┐",
      "outputColor": "90"
    },

    // ═══ SYSTEM ═══ (Cyan)
    {
      "type": "os",
      "key": "  │    OS",
      "keyColor": "36"
    },
    {
      "type": "host",
      "key": "  │  󰌢  Host",
      "keyColor": "36"
    },
    {
      "type": "kernel",
      "key": "  │    Kernel",
      "keyColor": "36"
    },
    {
      "type": "uptime",
      "key": "  │    Uptime",
      "keyColor": "36"
    },

    // ═══ HARDWARE ═══ (Green)
    {
      "type": "custom",
      "format": "  ├──── HARDWARE ──────────────────────────────────────────┤",
      "outputColor": "32"
    },
    {
      "type": "cpu",
      "format": "{name}",
      "key": "  │  󰻠  CPU",
      "keyColor": "32"
    },
    {
      "type": "gpu",
      "format": "{name}",
      "key": "  │  󰍛  GPU",
      "keyColor": "32"
    },
    {
      "type": "memory",
      "key": "  │    Memory",
      "keyColor": "32"
    },
    {
      "type": "disk",
      "folders": "/",
      "format": "{1} / {2} ({3})",
      "key": "  │    Disk",
      "keyColor": "32"
    },
    {
      "type": "battery",
      "format": "{4} [{5}]",
      "key": "  │    Battery",
      "keyColor": "32"
    },

    // ═══ SOFTWARE ═══ (Blue)
    {
      "type": "custom",
      "format": "  ├──── SOFTWARE ──────────────────────────────────────────┤",
      "outputColor": "34"
    },
    {
      "type": "shell",
      "key": "  │    Shell",
      "keyColor": "34"
    },
    {
      "type": "terminal",
      "key": "  │    Terminal",
      "keyColor": "34"
    },
    {
      "type": "packages",
      "key": "  │  󰏗  Packages",
      "keyColor": "34"
    },

    // ═══ COLORS ═══ (Yellow)
    {
      "type": "custom",
      "format": "  ├──── COLORS ────────────────────────────────────────────┤",
      "outputColor": "33"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 10
    },

    // ── Bottom Border ──
    {
      "type": "custom",
      "format": "  └────────────────────────────────────────────────────────┘",
      "outputColor": "90"
    },

    // ── Bottom Color Bar ──
    {
      "type": "custom",
      "format": "  █▓▒ █▓▒ █▓▒ █▓▒ █▓▒ █▓▒ █▓▒",
      "outputColor": "90"
    },

    "break"
  ]
}
