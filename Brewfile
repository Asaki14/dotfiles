# What the configs in this repo call. The trailing comment names the config
# directories that need each package: `install.sh --modules yazi` installs
# only the lines tagged yazi. The desktop's own packages (window manager,
# terminal, fonts) are in omacosy/src/Brewfile, which its installer runs.

brew "fish"            # fish
brew "zoxide"          # fish yazi
brew "fzf"             # fish yazi
brew "git"             # git
brew "gh"              # gh
brew "btop"            # btop
brew "neovim"          # nvim
brew "ripgrep"         # nvim yazi
brew "fd"              # nvim yazi
brew "yazi"            # yazi
brew "ffmpeg"          # yazi
brew "sevenzip"        # yazi
brew "poppler"         # yazi
brew "resvg"           # yazi
brew "imagemagick"     # yazi
brew "mpd"             # mpd
brew "miniserve"       # photoup
brew "yt-dlp"          # mpd fish
brew "rmpc"            # rmpc
brew "cava"            # rmpc
brew "beets"           # beets
cask "karabiner-elements" # karabiner
cask "linearmouse"     # linearmouse
cask "tinycast"        # tinycast
